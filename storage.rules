rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/documents/{allPaths=**} {
      // Access should be authenticated. 
      // Individual files can still be shared via tokenized download URLs.
      allow read, write: if request.auth != null;
    }
    
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
