rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{projectId}/documents/{allPaths=**} {
      // Allowing read if the request has the correct token in the URL (built-in Firebase Storage behavior)
      // or if the user is authenticated. 
      allow read: if true; 
      
      // Uploads should be authenticated or done through our secure Cloud Function (Admin SDK)
      allow write: if request.auth != null;
    }
    
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
